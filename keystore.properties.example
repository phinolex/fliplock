# Copiez ce fichier en « keystore.properties » (ignoré par git) pour signer
# les builds release avec VOTRE clé.
#
# Créer une clé (une seule fois, gardez-la précieusement et sauvegardez-la :
# sans elle vous ne pourrez plus publier de mise à jour de cette application) :
#
#   keytool -genkeypair -v -keystore fliplock-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias fliplock
#
storeFile=fliplock-release.jks
storePassword=CHANGEZ_MOI
keyAlias=fliplock
keyPassword=CHANGEZ_MOI
