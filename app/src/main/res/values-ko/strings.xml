    <string name="adv_close_threshold">닫힘 임계값</string>
    <string name="adv_close_threshold_help">이 값보다 밝으면 FlipLock은 덮개가 닫히지 않았다고 판단합니다.</string>
    <string name="adv_min_drop">최소 하강 비율</string>
    <string name="adv_min_absolute_drop">최소 절대 하강량</string>
    <string name="adv_confirmation">확인 시간</string>
