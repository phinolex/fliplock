    <string name="dark_test_title">어두운 곳에서 테스트</string>
    <string name="dark_test_body">테스트하려는 조명 환경에서 케이스를 열어 둔 채로 측정을 시작하세요.</string>
    <string name="dark_test_run">어두운 곳에서 테스트</string>
